{
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "tray",
        "network#down",
        "network#up",
        "cpu",
        "memory",
        "temperature",
        "pulseaudio",
        "wireplumber#source",
        "clock",
        "idle_inhibitor",
        "custom/power"
    ],
    "niri/workspaces": {
        "format": "{index}"
    },
    "niri/window": {
        "max-length": 60
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰛊"
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format": "{:%a %b %e  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": " {usage: >2}%",
        "tooltip": false
    },
    "memory": {
        "format": " {percentage: >2}%"
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC: >2}°C",
        "format-critical": "󰸁 {temperatureC: >2}°C",
        "format-icons": [
            "󱃃",
            "󰔏",
            "󱃂"
        ]
    },
    "pulseaudio": {
        "format": "{icon} {volume: >3}%",
        "format-bluetooth": "{icon}󰂯 {volume: >3}%",
        "format-bluetooth-muted": "󰖁󰂯 {volume: >3}%",
        "format-muted": "󰖁 {volume: >3}%",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "󰍬",
        "format-muted": "󰍭",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol --tab=4",
        "tooltip-format": "{node_name}",
        "on-scroll-up": "true",
        "on-scroll-down": "true"
    },
    "network#down": {
        "format-wifi": "{icon} {essid} 󰇚 {bandwidthDownBytes}",
        "format-ethernet": "󰈀 󰇚 {bandwidthDownBytes}",
        "format-linked": "󰌙 No IP",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}\nClick: open nmtui",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "alacritty -e nmtui",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) on {ifname} via {gwaddr}\nClick: open nmtui",
        "interval": 2,
        "align": 0
    },
    "network#up": {
        "format-wifi": "󰕒 {bandwidthUpBytes}",
        "format-ethernet": "󰕒 {bandwidthUpBytes}",
        "format-linked": " ",
        "format-disconnected": " ",
        "tooltip-format": "{ifname} via {gwaddr}\nClick: open nmtui",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "on-click": "alacritty -e nmtui",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) on {ifname} via {gwaddr}\nClick: open nmtui",
        "interval": 2,
        "align": 0
    }
}
